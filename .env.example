# Kopieren nach .env und anpassen:
#   cp .env.example .env

# MQTT Broker
MQTTACTIVE=true
MQTTHOST=192.168.178.x
MQTTPORT=1883
MQTTTOPIC=heizung/

# MQTT Auth (leer lassen wenn kein Auth)
MQTTUSER=
MQTTPASSWORD=

# Abfrageintervall in Sekunden
INTERVAL=60

# Datenpunkte - angepasst für Vitodens 200W / VScotHO1 (Device-ID 20CB 28CB)
# Achtung: Adressbereich 0x08xx, nicht 0x01xx!
# Alle für Vitodens 200W / Vitotronic 200 HO1B (Device-ID 20CB) (von mir) getesteten Befehle
COMMANDS=getTempA,getTempKessel,getTempVL,getTempRL,getTempWW,getTempAbgas,getBetriebArtHK1,getStatusStoerung
